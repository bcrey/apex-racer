# DATABASE_URL: Postgres connection string for persistent leaderboard storage.
# Keep the real value in .env.local so it stays out of source control.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# VITE_SUPABASE_URL: Public project URL used by the browser for Supabase Realtime.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# VITE_SUPABASE_PUBLISHABLE_KEY: Public browser key for Supabase Realtime.
# You can use either a publishable key or the legacy anon key.
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
